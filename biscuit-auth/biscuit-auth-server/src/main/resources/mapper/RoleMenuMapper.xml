<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bbwres.biscuit.module.auth.dao.RoleMenuMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="cn.bbwres.biscuit.module.auth.entity.RoleMenuEntity">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="creator" property="creator" />
        <result column="updater" property="updater" />
        <result column="update_time" property="updateTime" />
        <result column="role_id" property="roleId" />
        <result column="menu_id" property="menuId" />
        <result column="tenant_id" property="tenantId" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, create_time, creator, updater, update_time, role_id, menu_id, tenant_id
    </sql>

    <!-- 根据roleId 查询关联的菜单信息（忽略租户隔离，对应 @InterceptorIgnore） -->
    <select id="findByRoleIdNoTenant"
            resultType="cn.bbwres.biscuit.module.auth.entity.MenuEntity">
        select m.*
        from t_role_menu rm
                 left join t_menu m on m.id = rm.menu_id
        where rm.role_id = #{roleId,jdbcType=VARCHAR}
          and m.status = #{status}
    </select>

    <!-- 根据角色ID获取菜单数据 -->
    <select id="findByRoleId"
            resultType="cn.bbwres.biscuit.module.auth.entity.MenuEntity">
        select m.*
        from t_role_menu rm
                 left join t_menu m on m.id = rm.menu_id
        where rm.role_id = #{roleId,jdbcType=VARCHAR}
          and m.status = #{status}
    </select>

    <!-- 根据角色id 查询出关联菜单的所有接口（忽略租户隔离，对应 @InterceptorIgnore） -->
    <select id="findApisByRoleIdNoTenant"
            resultType="cn.bbwres.biscuit.module.auth.entity.MenuApiEntity">
        select ma.*
        from t_menu_api ma
                 inner join t_role_menu rm on rm.menu_id = ma.menu_id
                 inner join t_menu m on m.id = ma.menu_id
        where rm.role_id = #{roleId,jdbcType=VARCHAR}
          and m.status = #{status}
    </select>

</mapper>
